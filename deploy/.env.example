POSTGRES_USER=rmis
POSTGRES_PASSWORD=rmis
POSTGRES_DB=rmis
MINIO_ROOT_USER=rmis
MINIO_ROOT_PASSWORD=rmis-secret

RMIS_DATABASE_URL=postgresql+psycopg://rmis:rmis@db:5432/rmis
RMIS_REDIS_URL=redis://redis:6379/0
RMIS_S3_ENDPOINT_URL=http://minio:9000
RMIS_S3_BUCKET=rmis
RMIS_SOLVER_TIME_LIMIT_SECONDS=300
RMIS_STALE_AFTER_SECONDS=300

# Optional read-only OpenAI-compatible context assistant (AI-01).
RMIS_ASSISTANT_LLM_ENABLED=false
RMIS_ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
RMIS_ASSISTANT_LLM_API_KEY=
RMIS_ASSISTANT_LLM_API_KEY_REQUIRED=true
RMIS_ASSISTANT_LLM_MODEL=gpt-4o-mini
RMIS_ASSISTANT_LLM_TIMEOUT_SECONDS=10
RMIS_ASSISTANT_LLM_MAX_TOKENS=500
RMIS_ASSISTANT_LLM_SEND_TEMPERATURE=true
RMIS_ASSISTANT_LLM_TEMPERATURE=0
RMIS_ASSISTANT_LLM_TOKEN_LIMIT_PARAMETER=max_tokens
RMIS_ASSISTANT_LLM_MAX_CONTEXT_CHARS=24000
