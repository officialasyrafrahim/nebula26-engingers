# PostgreSQL 16 (Compose service `db`)
POSTGRES_USER=rao
POSTGRES_PASSWORD=rao
POSTGRES_DB=rao
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Backend settings. Compose builds RAO_DATABASE_URL from the POSTGRES_* values.
# RAO_* = Rail Access Optimisation.
RAO_REDIS_URL=redis://redis:6379/0
RAO_QUEUE_BACKEND=redis
RAO_QUEUE_NAME=rao:jobs
RAO_START_INPROCESS_WORKER=false
RAO_WORKER_POLL_SECONDS=1.0
RAO_SOLVER_TIME_LIMIT_SECONDS=300
RAO_SOLVER_SEED=42
RAO_HORIZON_EXTENSION_WEEKS=6
# CP-SAT worker portfolio size. 1 keeps parallel search off, so a fixed seed
# replays the same run. Raising it uses more CPUs and can change intermediate
# search results even with a fixed seed. Range 1..64.
RAO_SEARCH_WORKERS=1

# Compute allocation. The solver worker gets the largest share because CP-SAT
# scales across cores. Tune to the host; defaults assume a 32-core, 64 GB box.
API_CPUS=4
API_MEMORY=4g
WORKER_CPUS=28
WORKER_MEMORY=36g
WORKER_MEMORY_RESERVATION=8g
DB_MEMORY=4g
REDIS_MEMORY=1g
WEB_CPUS=2
WEB_MEMORY=512m

# Optional LTA DataMall advisory context (api service only). Leave empty to
# disable it. This is a secret: never commit it and never expose it to the UI.
LTA_DATAMALL_ACCOUNT_KEY=

# The official PS1 validator is NOT shipped. Leave empty to use the deterministic
# fallback oracle. To use an official validator, place it in deploy/validator
# (mounted at /opt/validator in the rail-solver-worker) and set the command, e.g.
# RAO_VALIDATOR_COMMAND=python /opt/validator/validate.py
RAO_VALIDATOR_COMMAND=

# Web. The production image serves the built SPA over nginx and proxies /api and
# /healthz to the upstream below. Leave VITE_API_ORIGIN empty for same-origin.
RAO_API_UPSTREAM=api:8000
# Container DNS nginx uses to re-resolve the api upstream. Docker Compose uses
# 127.0.0.11; plain rootless Podman uses the network gateway (often 10.89.0.1).
RAO_DNS_RESOLVER=127.0.0.11
VITE_API_ORIGIN=
API_HOST_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=5173
